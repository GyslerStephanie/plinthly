# local tooling — ignore .claude/ except the shared, committed bits.
# Uses .claude/* rather than .claude/ so the negations below can re-include:
# git cannot re-include a path whose parent directory is excluded.
.claude/*
!.claude/skills/
!.claude/launch.json

# Local secrets — never commit (ANTHROPIC_API_KEY lives here in dev)
.env
.env.*
!.env.example
